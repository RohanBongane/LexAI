# ==============================================================================
# LexAI – Production Environment Variables Template
# Copy this file to .env for local development.
# In Vercel, add these variables in: Project Settings -> Environment Variables.
# NEVER commit your actual .env file or real secrets to Git.
# ==============================================================================

# Core Application Settings
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=generate_a_random_32_byte_hex_string_for_production

# Database Configuration
# Option A: Unified Connection URL (Recommended for cloud providers like TiDB, Aiven, PlanetScale)
DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>

# Option B: Individual Database Parameters (Used if DATABASE_URL is not provided)
DB_USER=root
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lexai_db
DB_SSL=false
# DB_SSL_CA=/path/to/isrgrootx1.pem # Optional SSL certificate path if required

# Security & Session Configuration
SESSION_COOKIE_SECURE=false # Set to true in Vercel production with HTTPS

# Google Gemini AI Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_ai_studio_api_key_here
AI_MODEL=gemini-3.6-flash

# Persistent Document Storage Configuration
# Options: 'local' (for local disk development) or 'cloudinary' (for Vercel production)
STORAGE_PROVIDER=local

# Cloudinary Credentials (Required when STORAGE_PROVIDER=cloudinary)
# You can provide either the single CLOUDINARY_URL or individual keys:
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Vector Database & RAG Configuration
# EMBEDDING_PROVIDER options: 'auto' (Gemini API in cloud/serverless, local SentenceTransformer if installed)
EMBEDDING_PROVIDER=auto

# Hosted ChromaDB (Optional: set if using an external ChromaDB instance; otherwise uses local/ephemeral Chroma)
# CHROMA_HOST=your-chroma-host.com
# CHROMA_PORT=8000
# CHROMA_SSL=true
